{
    "name": "netgsm/otp",
    "description": "Netgsm SMS API v3 ile OTP SMS gönderimi",
    "type": "library",
    "license": "MIT",
    "keywords": ["netgsm", "otp", "sms"],
    "authors": [
        {
            "name": "Netgsm OTP",
            "email": "teknikdestek@netgsm.com.tr"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-curl": "*",
        "ext-json": "*",
        "psr/simple-cache": "^1.0 || ^2.0 || ^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Netgsm\\Otp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Netgsm\\Otp\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
